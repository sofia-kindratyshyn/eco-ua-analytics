# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/eco_ua_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=eco_ua_db
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=900
REDIS_DB=0

# External API Keys
SAVEECOBOT_API_KEY=your_saveecobot_api_key_here
SAVEECOBOT_API_URL=https://www.saveecobot.com/api
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_API_URL=https://api.openaq.org/v3
WAQI_API_KEY=your_waqi_api_key_here
WAQI_API_URL=https://api.waqi.info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Background Jobs
SYNC_SAVEECOBOT_INTERVAL=*/15 * * * *
SYNC_OPENAQ_INTERVAL=*/30 * * * *
CALCULATE_AGGREGATES_INTERVAL=0 * * * *

# API Settings
API_TIMEOUT=30000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1000
